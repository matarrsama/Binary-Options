rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pairs collection - read-only for public
    match /pairs/{pairId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Metadata collection - read-only for public
    match /metadata/{documentId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
